# ============================================
# IMPORTANT: Environment Variables Setup
# ============================================
# See docs/ENV_VARIABLES_SETUP.md for complete instructions
# MVP works without API keys in demo mode.
# For production (Vercel), set variables in Project Settings.
# Locally, keep secrets in .env.local (not in git!)

# ============================================
# Production URLs (change to your domain)
# ============================================
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example:
# APP_PUBLIC_URL=https://ufinf.com
# NEXT_PUBLIC_SITE_URL=https://ufinf.com

# ============================================
# AI Providers (optional, set in .env.local)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# ============================================
# Budget & Feature Limits
# ============================================
DAILY_GLOBAL_AI_BUDGET_USD=20
MAX_REQUEST_COST_USD=0.12
SOFT_STOP_PERCENT=80
FREE_DAILY_GENERATIONS=3
PRO_DAILY_GENERATIONS=40
PREMIUM_PLUS_DAILY_GENERATIONS=120

# ============================================
# Feature Flags
# ============================================
FEATURE_ONE_CLICK_PUBLISH=true
FEATURE_AI_CONTENT_BRAIN=true
# ============================================
# Admin Panel Security (REQUIRED)
# ============================================
# Local development defaults - CHANGE IN PRODUCTION!
ADMIN_EMAIL=admin@usinf.com
# Prefer hash in production:
# ADMIN_PASSWORD_HASH format:
# pbkdf2$sha256$<iterations>$<salt>$<hashBase64Url>
# Generate (Node.js):
# node -e "const c=require('crypto');const p='your-password';const i=210000;const s=c.randomBytes(16).toString('base64url');const h=c.pbkdf2Sync(p,s,i,32,'sha256').toString('base64url');console.log(`pbkdf2$sha256$${i}$${s}$${h}`)"
ADMIN_PASSWORD_HASH=
# Fallback plain password (minimum 10 chars in production)
ADMIN_PASSWORD=change-me-admin-password
# Session secret (minimum 32 characters)
# Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-admin-session-secret-with-32-plus-chars
# TOTP secret for 2FA (base32, minimum 32 chars)
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_ROLE=super_admin
# ============================================
# Stripe Payment Integration
# ============================================
# REQUIRED for production: Set in Vercel environment
# Test mode: sk_test_*, whsec_test_*
# Production: sk_live_*, whsec_live_*
# Get from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=
# IMPORTANT: Webhook signing secret (NOT the API key!)
# Get from Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=

# ============================================
# Social Media Integration (optional)
# ============================================
# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# YouTube
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# X (Twitter)
X_BEARER_TOKEN=
